{
  "name": "schema-editor",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "npm-run-all check:*",
    "check:lint": "biome check",
    "check:types": "tsc -p tsconfig.json --noEmit",
    "dev": "vite dev",
    "fix": "biome check --write",
    "sort": "sort-package-json",
    "start": "node .output/server/index.mjs",
    "updates": "npm-check-updates -u"
  },
  "dependencies": {
    "@neodrag/solid": "3.0.0-next.8",
    "@solidjs/meta": "0.29.4",
    "@solidjs/start": "2.0.6",
    "@tanstack/solid-devtools": "^0.8.13",
    "@tanstack/solid-form": "^1.33.5",
    "@tanstack/solid-form-devtools": "^0.2.34",
    "@tanstack/solid-hotkeys": "^0.13.0",
    "@tanstack/solid-hotkeys-devtools": "^0.10.0",
    "@tanstack/solid-pacer": "^0.24.0",
    "@tanstack/solid-pacer-devtools": "^0.8.1",
    "@tanstack/solid-query": "^5.104.1",
    "@tanstack/solid-query-devtools": "^5.104.1",
    "@tanstack/solid-router": "^1.170.38",
    "@tanstack/solid-router-devtools": "^1.167.2",
    "nitro": "3.0.260903-beta",
    "solid-icons": "1.2.0",
    "solid-js": "1.9.17",
    "valibot": "1.5.0",
    "vite": "8.3.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
