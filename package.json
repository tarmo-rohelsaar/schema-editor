    "@tanstack/router-plugin": "^1.168.42",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.4",
    "jsdom": "30.1.2",
    "npm-check-updates": "23.1.0",
    "npm-run-all": "4.1.5",
    "semantic-release": "25.0.9",
    "sort-package-json": "4.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
